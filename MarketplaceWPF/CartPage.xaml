<Page x:Class="MarketplaceWPF.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ваша корзина" FontSize="24" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CartList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8" Margin="0,5" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProductName, Mode=OneWay}" 
                                               FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="Gray" FontSize="11"
                                               Text="{Binding ShopName, Mode=OneWay, TargetNullValue='—'}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" 
                                            VerticalAlignment="Center" Margin="0,0,15,0">
                                    <Button Content="−" Width="32" Height="32" Padding="0" FontSize="16"
                                            Click="BtnDecrease_Click" Tag="{Binding Id, Mode=OneWay}" Margin="0,0,5,0"/>
                                    <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="50" Height="32"
                                             TextAlignment="Center" VerticalContentAlignment="Center"
                                             FontSize="14" Margin="0,0,5,0"
                                             Tag="{Binding Id, Mode=OneWay}"
                                             LostFocus="TxtQuantity_LostFocus"
                                             KeyDown="TxtQuantity_KeyDown"/>
                                    <Button Content="+" Width="32" Height="32" Padding="0" FontSize="16"
                                            Click="BtnIncrease_Click" Tag="{Binding Id, Mode=OneWay}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SubtotalText, Mode=OneWay}"
                                               FontSize="16" FontWeight="Bold" 
                                               Foreground="#10B981"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock FontSize="11" Foreground="Gray"
                                               HorizontalAlignment="Right"
                                               Visibility="{Binding HasDiscount, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <Run Text="{Binding PriceText, Mode=OneWay}"/>
                                        <Run Text=" × "/>
                                        <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="3" Content="✕" Background="#EF4444" 
                                        Width="32" Height="32" Padding="0" FontSize="14" Margin="15,0,0,0"
                                        Click="BtnRemove_Click" Tag="{Binding Id, Mode=OneWay}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" Margin="0,20,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Основной блок: слева поля, справа сумма -->
                    <RowDefinition Height="Auto"/>
                    <!-- Кнопка "Оформить заказ" -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Левая колонка -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Правая колонка -->
                </Grid.ColumnDefinitions>

                <!-- ==================== ЛЕВАЯ КОЛОНКА ==================== -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,30,0">

                    <!-- Промокод -->
                    <TextBlock Text="Промокод:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPromoCode" Grid.Column="0" FontSize="14" Padding="8,6"/>
                        <Button Grid.Column="1" Content="Применить" Click="BtnApplyPromo_Click" 
                                Margin="10,0,10,0" Padding="15,6"/>
                        <TextBlock x:Name="TxtPromoStatus" Grid.Column="2" 
                                   VerticalAlignment="Center" FontSize="12"/>
                    </Grid>

                    <!-- Способ оплаты -->
                    <TextBlock Text="Способ оплаты:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Margin="0,0,0,15">
                        <RadioButton x:Name="RbCard" Content="💳 Банковская карта" 
                                     GroupName="Payment" IsChecked="True"
                                     FontSize="14" Margin="0,0,0,6"/>
                        <RadioButton x:Name="RbCash" Content="💵 Наличными при получении" 
                                     GroupName="Payment"
                                     FontSize="14" Margin="0,0,0,6"/>
                        <RadioButton x:Name="RbOnline" Content="📱 Онлайн-перевод (СБП)" 
                                     GroupName="Payment"
                                     FontSize="14"/>
                    </StackPanel>

                    <!-- Адрес доставки -->
                    <TextBlock Text="Адрес доставки:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtDeliveryAddress" 
                             FontSize="14" Padding="8,6"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="60" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="Город, улица, дом, квартира"/>
                </StackPanel>

                <!-- ==================== ПРАВАЯ КОЛОНКА ==================== -->
                <StackPanel Grid.Row="0" Grid.Column="1" 
                            MinWidth="260" VerticalAlignment="Bottom">
                    <!-- Сумма без скидки -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Сумма без скидки:" FontSize="13" 
                                   Foreground="Gray" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSubtotal" Grid.Column="1" 
                                   FontSize="13" Foreground="Gray" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Скидка по промокоду -->
                    <Grid x:Name="PromoDiscountRow" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Скидка:" FontSize="13" 
                                   Foreground="#EF4444" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtPromoDiscountAmount" Grid.Column="1" 
                                   FontSize="13" Foreground="#EF4444" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Итого -->
                    <TextBlock Text="Итого к оплате:" FontSize="14" 
                               Foreground="Gray" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TxtTotal" FontSize="28" FontWeight="Bold" 
                               HorizontalAlignment="Right" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- ==================== КНОПКА СНИЗУ ==================== -->
                <Button Grid.Row="1" Grid.Column="0" 
                        Content="Оформить заказ" 
                        Click="BtnCheckout_Click" Padding="30,12" FontSize="16" 
                        HorizontalAlignment="Left"
                        MinWidth="220"
                        Margin="0,20,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Page>