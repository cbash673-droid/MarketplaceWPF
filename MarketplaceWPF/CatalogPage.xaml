<Page x:Class="MarketplaceWPF.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Каталог товаров" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCart" Content="🛒 Корзина" Click="BtnCart_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnMyOrders" Content="📦 Мои заказы" Click="BtnMyOrders_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnSeller" Content="🏪 Мой магазин" Click="BtnSeller_Click" 
                        Visibility="Collapsed" Margin="0,0,10,0"/>
                <Button x:Name="BtnAdmin" Content="⚙️ Админ" Click="BtnAdmin_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="TxtSearch" FontSize="14" Padding="10,8"
                             ToolTip="Поиск по названию или описанию"
                             TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock x:Name="TxtSearchPlaceholder" Text="🔍 Поиск..." 
                               Foreground="Gray" Margin="15,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>

                <TextBlock Grid.Column="1" Text="Категория:" 
                           VerticalAlignment="Center" Margin="15,0,8,0"/>
                <ComboBox x:Name="CmbCategory" Grid.Column="2" 
                          Width="220" FontSize="14" Padding="8,6"
                          SelectionChanged="CmbCategory_SelectionChanged"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProductsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Карточка товара: клик открывает окно, кнопка — добавляет в корзину -->
                        <Border Background="White" CornerRadius="8" Margin="10" 
                                Width="250" Padding="15"
                                Cursor="Hand"
                                MouseLeftButtonUp="ProductCard_Click">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Картинка -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Название (фикс.) -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Описание (фикс.) -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Категория + магазин -->
                                    <RowDefinition Height="*"/>
                                    <!-- Пустой распор -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Цена + кнопка -->
                                </Grid.RowDefinitions>

                                <!-- Фото -->
                                <Border Grid.Row="0" Background="#E5E7EB" Height="140" 
                                        CornerRadius="6" Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock Text="📦" FontSize="40" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding ImageFullPath, Mode=OneWay}" 
                                               Stretch="UniformToFill"/>

                                        <Border Background="#EF4444" CornerRadius="4" Padding="6,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"
                                                Visibility="{Binding HasDiscount, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding DiscountText, Mode=OneWay}" 
                                                       Foreground="White" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Название — фиксированная высота, 2 строки максимум -->
                                <TextBlock Grid.Row="1" 
                                           Text="{Binding Name, Mode=OneWay}" 
                                           FontSize="15" FontWeight="SemiBold" 
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="40"/>

                                <!-- Описание — фиксированная высота, 2 строки максимум -->
                                <TextBlock Grid.Row="2" 
                                           Text="{Binding Description, Mode=OneWay}" 
                                           FontSize="12" Foreground="Gray" 
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="32"
                                           Margin="0,5,0,5"/>

                                <!-- Категория + магазин -->
                                <StackPanel Grid.Row="3">
                                    <TextBlock Text="{Binding CategoryName, Mode=OneWay}" 
                                               FontSize="11" Foreground="#4B5563"/>
                                    <TextBlock Text="{Binding ShopName, Mode=OneWay, StringFormat='🏪 {0}'}" 
                                               FontSize="11" Foreground="#6B7280"/>
                                </StackPanel>

                                <!-- Пустой распор — прижимает нижний блок вниз -->
                                <Border Grid.Row="4" Height="10"/>

                                <!-- Цена + кнопка -->
                                <Grid Grid.Row="5" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FinalPriceText, Mode=OneWay}" 
                                                       FontSize="16" FontWeight="Bold" 
                                                       Foreground="#10B981"/>
                                            <TextBlock Text="{Binding PriceText, Mode=OneWay}" 
                                                       FontSize="11" Foreground="Gray"
                                                       TextDecorations="Strikethrough"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0"
                                                       Visibility="{Binding HasDiscount, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding StockText, Mode=OneWay}" 
                                                   FontSize="11" Foreground="Gray"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Click="AddToCart_Click"
                                            Tag="{Binding Id, Mode=OneWay}"
                                            VerticalAlignment="Center"
                                            Padding="10,6">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="В корзину"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stock, Mode=OneWay}" Value="0">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Content" Value="Нет в наличии"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>