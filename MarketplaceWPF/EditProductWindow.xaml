<Window x:Class="MarketplaceWPF.EditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование товара" Height="560" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Редактирование товара" FontSize="20" FontWeight="Bold" 
                   Grid.Row="0" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Название:" Grid.Row="0" Grid.Column="0" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtName" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10"/>

                <TextBlock Text="Описание:" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtDesc" Grid.Row="1" Grid.Column="1" Margin="0,0,10,10"/>

                <TextBlock Text="Цена ($):" Grid.Row="2" Grid.Column="0" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPrice" Grid.Row="3" Grid.Column="0" Margin="0,0,10,10"/>

                <TextBlock Text="Кол-во на складе:" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtStock" Grid.Row="3" Grid.Column="1" Margin="0,0,10,10"/>

                <TextBlock Text="Категория:" Grid.Row="4" Grid.Column="0" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbCategory" Grid.Row="5" Grid.Column="0" 
                          Margin="0,0,10,0" FontSize="14" Padding="8,6"/>

                <TextBlock Text="Скидка на товар (%):" Grid.Row="4" Grid.Column="1" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtDiscount" Grid.Row="5" Grid.Column="1" 
                         Margin="0,0,10,0" FontSize="14" Padding="8,6"/>

                <Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="2"
                        Width="120" Height="120" Background="#F3F4F6"
                        CornerRadius="8" BorderBrush="#D1D5DB" BorderThickness="1"
                        VerticalAlignment="Top">
                    <Grid>
                        <TextBlock x:Name="TxtNoImage" Text="📷&#x0a;нет фото" 
                                   FontSize="14" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center"/>
                        <Image x:Name="ImgPreview" Stretch="UniformToFill"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Выбрать фото" Click="BtnChooseImage_Click" 
                    Background="#6B7280" Margin="0,0,10,0" Padding="20,8"/>
            <Button Content="Отмена" Click="BtnCancel_Click" 
                    Background="#9CA3AF" Margin="0,0,10,0" Padding="20,8"/>
            <Button Content="Сохранить" Click="BtnSave_Click" 
                    Background="#10B981" Padding="20,8"/>
        </StackPanel>
    </Grid>
</Window>