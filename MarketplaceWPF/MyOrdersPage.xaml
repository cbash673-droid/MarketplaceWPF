<Page x:Class="MarketplaceWPF.MyOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Мои заказы" FontSize="24" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="OrdersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8" Margin="0,5" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold">
                                        <Run Text="Заказ "/>
                                        <Run Text="{Binding OrderCode, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock Foreground="Gray" FontSize="12" Margin="0,3,0,0">
                                        <Run Text="Оформлен: "/>
                                        <Run Text="{Binding CreatedAtText, Mode=OneWay}"/>
                                        <Run Text="  •  "/>
                                        <Run Text="{Binding StatusText, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock Foreground="Gray" FontSize="12" Margin="0,3,0,0">
                                        <Run Text="Оплата: "/>
                                        <Run Text="{Binding PaymentMethodText, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock Foreground="Gray" FontSize="12" Margin="0,3,0,0"
                                               TextWrapping="Wrap">
                                        <Run Text="Адрес: "/>
                                        <Run Text="{Binding DeliveryAddress, Mode=OneWay, TargetNullValue='—'}"/>
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{Binding Items, Mode=OneWay}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="#4B5563" FontSize="13">
                                                    <Run Text="• "/>
                                                    <Run Text="{Binding ProductName, Mode=OneWay}"/>
                                                    <Run Text=" × "/>
                                                    <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                                    <Run Text=" шт. — "/>
                                                    <Run Text="{Binding PriceText, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock FontSize="18" FontWeight="Bold" 
                                               Foreground="{StaticResource PrimaryBrush}" 
                                               Margin="0,10,0,0">
                                        <Run Text="Итого: "/>
                                        <Run Text="{Binding TotalText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <Button Content="Показать QR" Click="BtnShowQr_Click" 
                                            Tag="{Binding OrderCode, Mode=OneWay}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>