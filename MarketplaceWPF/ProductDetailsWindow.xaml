<Window x:Class="MarketplaceWPF.ProductDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Фото слева -->
                <Border Grid.Column="0" Background="#F3F4F6" CornerRadius="8"
                        Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                        <TextBlock Text="📦" FontSize="80" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#9CA3AF"/>
                        <Image x:Name="ImgProduct" Stretch="UniformToFill"/>

                        <!-- Бейдж скидки -->
                        <Border x:Name="BadgeDiscount" Background="#EF4444" CornerRadius="4" 
                                Padding="8,3"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TxtBadgeDiscount" Foreground="White" 
                                       FontWeight="Bold" FontSize="14"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Информация справа -->
                <StackPanel Grid.Column="1" Margin="25,0,0,0">
                    <TextBlock x:Name="TxtName" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>

                    <!-- Категория -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Категория: " FontSize="13" Foreground="#6B7280"/>
                        <TextBlock x:Name="TxtCategory" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                    </StackPanel>

                    <!-- Магазин -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Магазин: " FontSize="13" Foreground="#6B7280"/>
                        <TextBlock x:Name="TxtShop" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                    </StackPanel>

                    <!-- Цена -->
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFinalPrice" FontSize="32" FontWeight="Bold" 
                                   Foreground="#10B981"/>
                        <TextBlock x:Name="TxtOldPrice" FontSize="16" Foreground="Gray"
                                   TextDecorations="Strikethrough"
                                   VerticalAlignment="Bottom" Margin="12,0,0,6"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Остаток -->
                    <TextBlock x:Name="TxtStock" FontSize="14" Foreground="#6B7280" Margin="0,6,0,0"/>

                    <!-- Разделитель -->
                    <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Margin="0,20,0,15"/>

                    <!-- Описание -->
                    <TextBlock Text="Описание" FontSize="14" FontWeight="SemiBold" 
                               Foreground="#374151" Margin="0,0,0,5"/>
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtDescription" FontSize="13" 
                                   Foreground="#4B5563" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Кнопки снизу -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Закрыть" Click="BtnClose_Click" 
                    Background="#9CA3AF" Padding="30,10" FontSize="14"
                    Margin="0,0,10,0" MinWidth="130"/>
            <Button x:Name="BtnAddToCart" Content="🛒 В корзину" Click="BtnAddToCart_Click" 
                    Background="#2563EB" Padding="30,10" FontSize="14"
                    MinWidth="180"/>
        </StackPanel>
    </Grid>
</Window>