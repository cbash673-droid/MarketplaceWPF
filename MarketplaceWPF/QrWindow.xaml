<Window x:Class="MarketplaceWPF.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR-код заказа" Height="500" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="White"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Покажите этот QR-код на пункте выдачи" 
                   FontSize="14" Foreground="Gray" 
                   HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#F3F4F6" CornerRadius="8" Padding="15">
            <Image x:Name="QrImage" Stretch="Uniform"/>
        </Border>

        <TextBlock x:Name="TxtCode" Grid.Row="2" 
                   FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,15,0,0"/>

        <Button Grid.Row="3" Content="Закрыть" Click="BtnClose_Click"
                HorizontalAlignment="Center" Margin="0,15,0,0" Padding="30,8"/>
    </Grid>
</Window>