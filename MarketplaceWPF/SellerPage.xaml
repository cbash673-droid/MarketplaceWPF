<Page x:Class="MarketplaceWPF.SellerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Кабинет продавца" FontSize="24" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,20"/>

        <!-- Создание магазина -->
        <Border x:Name="CreateShopPanel" Grid.Row="1" Background="White" CornerRadius="8" 
                Padding="20" Margin="0,0,0,20" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Создайте свой магазин" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                <TextBlock Text="Название магазина:" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtShopName" Margin="0,0,0,10"/>
                <TextBlock Text="Описание:" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtShopDesc" Margin="0,0,0,10"/>
                <Button Content="Создать магазин" Click="BtnCreateShop_Click" HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <!-- Управление магазином -->
        <TabControl x:Name="ShopManagePanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed">
            <!-- ============ ВКЛАДКА ТОВАРОВ ============ -->
            <TabItem Header="Товары">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock x:Name="TxtShopTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Название:" Grid.Row="0" Grid.Column="0" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtName" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10"/>

                                <TextBlock Text="Описание:" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtDesc" Grid.Row="1" Grid.Column="1" Margin="0,0,10,10"/>

                                <TextBlock Text="Цена ($):" Grid.Row="2" Grid.Column="0" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtPrice" Grid.Row="3" Grid.Column="0" Margin="0,0,10,10"/>

                                <TextBlock Text="Кол-во на складе:" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtStock" Grid.Row="3" Grid.Column="1" Margin="0,0,10,10"/>

                                <TextBlock Text="Категория:" Grid.Row="4" Grid.Column="0" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbCategory" Grid.Row="5" Grid.Column="0" 
                                          Margin="0,0,10,0" FontSize="14" Padding="8,6"/>

                                <TextBlock Text="Скидка (%):" Grid.Row="4" Grid.Column="1" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtDiscount" Grid.Row="5" Grid.Column="1" 
                                         Margin="0,0,10,0" FontSize="14" Padding="8,6"/>

                                <Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="2"
                                        Width="120" Height="120" Background="#F3F4F6"
                                        CornerRadius="8" BorderBrush="#D1D5DB" BorderThickness="1"
                                        VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock x:Name="TxtNoImage" Text="📷&#x0a;нет фото" 
                                                   FontSize="14" Foreground="#9CA3AF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                        <Image x:Name="ImgPreview" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                                <Button Content="Выбрать фото" Click="BtnChooseImage_Click" 
                                        Background="#6B7280" Margin="0,0,10,0"/>
                                <Button Content="Добавить товар" Click="BtnAdd_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SellerProductsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="8" Margin="0,5" Padding="15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="60" Height="60" Background="#F3F4F6" 
                                                    CornerRadius="6" Margin="0,0,15,0">
                                                <Grid>
                                                    <TextBlock Text="📦" FontSize="24" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding ImageFullPath, Mode=OneWay}" 
                                                           Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" 
                                                           FontSize="16" FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FinalPriceText, Mode=OneWay}" 
                                                               Foreground="#10B981" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding PriceText, Mode=OneWay}" 
                                                               Foreground="Gray" 
                                                               TextDecorations="Strikethrough" 
                                                               Margin="8,0,8,0"
                                                               Visibility="{Binding HasDiscount, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding DiscountText, Mode=OneWay}" 
                                                               Foreground="#EF4444" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock Foreground="Gray" FontSize="12">
                                                    <Run Text="Остаток: "/>
                                                    <Run Text="{Binding Stock, Mode=OneWay}"/>
                                                    <Run Text="  |  "/>
                                                    <Run Text="{Binding CategoryName, Mode=OneWay, TargetNullValue='—'}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="✏ Редактировать" 
                                                    Background="#2563EB" Margin="0,0,10,0"
                                                    Click="BtnEdit_Click" Tag="{Binding Id, Mode=OneWay}"/>

                                            <Button Grid.Column="3" Content="Удалить" Background="#EF4444" 
                                                    Click="BtnDelete_Click" Tag="{Binding Id, Mode=OneWay}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ ВКЛАДКА ПРОМОКОДОВ ============ -->
            <TabItem Header="Промокоды">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Создать промокод" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Код:" Grid.Row="0" Grid.Column="0" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtPromoCode" Grid.Row="1" Grid.Column="0" 
                                         Margin="0,0,10,0" FontSize="14" Padding="8,6"/>

                                <TextBlock Text="Скидка (%):" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtPromoDiscount" Grid.Row="1" Grid.Column="1" 
                                         FontSize="14" Padding="8,6"/>
                            </Grid>

                            <Button Content="Создать промокод" Click="BtnCreatePromo_Click" 
                                    Margin="0,15,0,0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PromoList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="8" Margin="0,5" Padding="15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Code, Mode=OneWay}" 
                                                           FontSize="18" FontWeight="Bold" Foreground="#2563EB"/>
                                                <TextBlock Foreground="Gray" FontSize="13">
                                                    <Run Text="Скидка: "/>
                                                    <Run Text="{Binding DiscountPercent, Mode=OneWay}"/>
                                                    <Run Text="%  |  Магазин: "/>
                                                    <Run Text="{Binding ShopName, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="Удалить" Background="#EF4444"
                                                    Click="BtnDeletePromo_Click" Tag="{Binding Id, Mode=OneWay}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>